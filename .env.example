# Database
DB_URL=jdbc:postgresql://localhost:5432/dsar_db
DB_USERNAME=dsar_user
DB_PASSWORD=dsar_password

# JWT
JWT_SECRET=change-this-to-a-long-random-secret-in-production
JWT_EXPIRATION_MS=86400000

# Mail (used for deadline warning / overdue alert emails)
MAIL_HOST=smtp.example.com
MAIL_PORT=587
MAIL_USERNAME=your-smtp-username
MAIL_PASSWORD=your-smtp-password

# Deadline monitoring
DSAR_LEGAL_DAYS=30
DSAR_WARNING_DAYS_BEFORE=5

# Optional LLM-assisted letter drafting (stretch feature, disabled by default)
LETTER_DRAFT_ENABLED=false
LETTER_DRAFT_PROVIDER=anthropic
LETTER_DRAFT_API_KEY=
LETTER_DRAFT_MODEL=claude-3-5-sonnet-latest

# Frontend
REACT_APP_API_BASE_URL=http://localhost:8080/api
